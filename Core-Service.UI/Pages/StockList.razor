@page "/stock"
@using FoodStock.Models
@using Core_Service.UI.Components
@inject StockService StockService
@inject CategoryService CategoryService
@inject ItemService ItemService
@inject NavigationManager NavigationManager
@inject IToastService ToastService


<div class="stocklist-container">
    <div class="stocklist-button-container">
        <button @onclick="() => ShowSection(Section.Items)">
            <i class="fas fa-box"></i>
            <div>Items</div>
        </button>
        <button @onclick="() => ShowSection(Section.Stocks)">
            <i class="fas fa-boxes"></i>
            <div>Stocks</div>
        </button>
        <button @onclick="() => ShowSection(Section.Categories)">
            <i class="fas fa-tags"></i>
            <div>Categories</div>
        </button>
    </div>

    <div class="stocklist-main-section">



        <div class="stocklist-header-section">
            <div class="column">
                <h4>@selectedSection.ToString()</h4>
                <button class="btn-create" @onclick="ShowCreateModal">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="column" style="display: flex; justify-content: flex-end;">
                <input type="text" class="search-input" placeholder="Search by id..." @bind="searchId"/>
                <button class="btn-search" @onclick="SearchItem">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>



        @if (selectedSection == Section.Stocks)
        {
            @if (isSearching)
            {
                @if (searchedStock == null)
                {
                    <p>No stock found with ID @searchId</p>
                }
                else
                {
                    <div class="stocklist-item">
                        <div class="column">
                            <strong>Name:</strong> @searchedStock.Name<br/>
                            <strong>Description:</strong> @searchedStock.Description<br/>
                            <strong>Category:</strong> @searchedStock.Category?.Name <br/>
                        </div>
                        <div class="column">
                            <strong>Quantity:</strong> @searchedStock.Quantity @searchedStock.MeasureType.<br/>
                            <strong>Min:</strong> @searchedStock.MinQuantity @searchedStock.MeasureType.<br/>
                            <strong>Max:</strong> @searchedStock.MaxQuantity @searchedStock.MeasureType.<br/>
                        </div>
                        <div class="column" style="display: flex; justify-content: flex-end;">
                            <button class="btn-edit" @onclick="() => ShowUpdateModal(searchedStock)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-delete" @onclick="() => DeleteStock(searchedStock.StockID)">
                                <i class="fas fa-trash"></i>
                            </button>

                        </div>
                    </div>
                }
            }
            else
            {
                @if (stocks == null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    @foreach (var stock in stocks)
                    {
                        <div class="stocklist-item">
                            <div class="column">
                                <strong>Name:</strong> @stock.Name<br/>
                                <strong>Description:</strong> @stock.Description<br/>
                                <strong>Category:</strong> @stock.Category?.Name <br/>
                            </div>
                            <div class="column">
                                <strong>Quantity:</strong> @stock.Quantity @stock.MeasureType.<br/>
                                <strong>Min:</strong> @stock.MinQuantity @stock.MeasureType.<br/>
                                <strong>Max:</strong> @stock.MaxQuantity @stock.MeasureType.<br/>
                            </div>
                            <div class="column" style="display: flex; justify-content: flex-end;">
                                <button class="btn-edit" @onclick="() => ShowUpdateModal(stock)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn-delete" @onclick="() => DeleteStock(stock.StockID)">
                                    <i class="fas fa-trash"></i>
                                </button>

                            </div>
                        </div>
                    }
                }
            }
        }



        else if (selectedSection == Section.Categories)
        {
            @if (isSearching)
            {
                @if (searchedCategory == null)
                {
                    <p>No category found with ID @searchId</p>
                }
                else
                {
                    <div class="stocklist-item">
                        <div class="column">
                            <strong>Name:</strong> @searchedCategory.Name<br/>
                            <strong>Description:</strong> @searchedCategory.Description<br/>
                        </div>
                        <div class="column">
                        </div>
                        <div class="column" style="display: flex; justify-content: flex-end;">
                            <button class="btn-edit" @onclick="() => ShowUpdateModal(searchedCategory)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-delete" @onclick="() => DeleteCategory(searchedCategory.CategoryID)">
                                <i class="fas fa-trash"></i>
                            </button>

                        </div>
                    </div>
                }
            }
            else
            {
                @if (categories == null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    @foreach (var category in categories)
                    {
                        <div class="stocklist-item">
                            <div class="column">
                                <strong>Name:</strong> @category.Name<br/>
                                <strong>Description:</strong> @category.Description<br/>
                            </div>
                            <div class="column">
                            </div>
                            <div class="column" style="display: flex; justify-content: flex-end;">
                                <button class="btn-edit" @onclick="() => ShowUpdateModal(category)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn-delete" @onclick="() => DeleteCategory(category.CategoryID)">
                                    <i class="fas fa-trash"></i>
                                </button>

                            </div>
                        </div>
                    }
                }
            }
        }



        else if (selectedSection == Section.Items)
        {
            @if (isSearching)
            {
                @if (searchedItem == null)
                {
                    <p>No item found with ID @searchId</p>
                }
                else
                {
                    <div class="stocklist-item">
                        <div class="column">
                            <strong>Name:</strong> @searchedItem.Stock.Name<br/>
                            <strong>Description:</strong> @searchedItem.Stock.Description<br/>
                            <strong>Item Description:</strong> @searchedItem.ItemDescription<br/>
                        </div>
                        <div class="column">
                            <strong>Spoil Date:</strong> @searchedItem.SpoilDate<br/>
                            <strong>Quantity:</strong> @searchedItem.Measure @searchedItem.Stock.MeasureType.<br/>
                        </div>
                        <div class="column" style="display: flex; justify-content: flex-end;">
                            <button class="btn-edit" @onclick="() => ShowUpdateModal(searchedItem)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-delete" @onclick="() => DeleteItem(searchedItem.ItemID)">
                                <i class="fas fa-trash"></i>
                            </button>

                        </div>
                    </div>
                }
            }
            else
            {
                @if (items == null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    @foreach (var item in items)
                    {
                        <div class="stocklist-item">
                            <div class="column">
                                <strong>Name:</strong> @item.Stock.Name<br/>
                                <strong>Description:</strong> @item.Stock.Description<br/>
                                <strong>Item Description:</strong> @item.ItemDescription<br/>
                            </div>
                            <div class="column">
                                <strong>Spoil Date:</strong> @item.SpoilDate<br/>
                                <strong>Quantity:</strong> @item.Measure @item.Stock.MeasureType.<br/>
                            </div>
                            <div class="column" style="display: flex; justify-content: flex-end;">
                                <button class="btn-edit" @onclick="() => ShowUpdateModal(item)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn-delete" @onclick="() => DeleteItem(item.ItemID)">
                                    <i class="fas fa-trash"></i>
                                </button>

                            </div>
                        </div>
                    }
                }
            }
        }



    </div>
</div>

@if (showCreateModal)
{
    @if (selectedSection == Section.Stocks)
    {
        <StockCreateModal OnClose="HideCreateModal" />
    }
    else if (selectedSection == Section.Categories)
    {
        <CategoryCreateModal OnClose="HideCreateModal" OnCategoryCreated="LoadCategories"/>
    }
    else if (selectedSection == Section.Items)
    {
        <ItemCreateModal OnClose="HideCreateModal"/>
    }
}

@if (showUpdateModal)
{
    @if (selectedSection == Section.Stocks && selectedEntity is StockModel)
    {
        <StockUpdateModal OnClose="HideUpdateModal" Stock="(StockModel)selectedEntity" />
    }
    else if (selectedSection == Section.Categories && selectedEntity is CategoryModel)
    {
        <CategoryUpdateModal OnClose="HideUpdateModal" Category="(CategoryModel)selectedEntity" OnCategoryUpdated="LoadCategories"/>
    }
    else if (selectedSection == Section.Items && selectedEntity is ItemModel)
    {
        <ItemUpdateModal OnClose="HideUpdateModal" Item="(ItemModel)selectedEntity" />
    }
    isSearching = false;
}

@code {
    private List<StockModel>? stocks;
    private List<CategoryModel>? categories;
    private List<ItemModel>? items;

    private StockModel? searchedStock;
    private CategoryModel? searchedCategory;
    private ItemModel? searchedItem;
    private object? selectedEntity;
    private string searchId = string.Empty;
    private bool isSearching = false;
    private bool showCreateModal = false;
    private bool showUpdateModal = false;

    private Section selectedSection = Section.Stocks;


    private enum Section
    {
        Stocks,
        Categories,
        Items
    }

    // Fetch data when the component is initialized
    protected override async Task OnInitializedAsync()
    {
        stocks = await StockService.GetStocksAsync();
        categories = await CategoryService.GetCategoriesAsync();
        items = await ItemService.GetItemsAsync();
    }

    private void ShowSection(Section section)
    {
        selectedSection = section;
        isSearching = false;
    }

    private async Task LoadCategories()
    {
        categories = await CategoryService.GetCategoriesAsync();
        StateHasChanged();
    }

    private void ShowCreateModal()
    {
        showCreateModal = true;
    }

    private async Task HideCreateModal()
    {
        showCreateModal = false;
        await LoadCategories();
    }

    private void ShowUpdateModal(object entity)
    {
        selectedEntity = entity;
        showUpdateModal = true;
    }

    private async Task HideUpdateModal()
    {
        showUpdateModal = false;
        await LoadCategories();
    }

    private async Task SearchItem()
    {
        if (int.TryParse(searchId, out int id))
        {
            try
            {
                if (selectedSection == Section.Stocks)
                {
                    searchedStock = await StockService.GetStockByIdAsync(id);
                    searchedItem = null;
                    searchedCategory = null;
                }
                else if (selectedSection == Section.Categories)
                {
                    searchedCategory = await CategoryService.GetCategoryByIdAsync(id);
                    searchedItem = null;
                    searchedStock = null;
                }
                else if (selectedSection == Section.Items)
                {
                    searchedItem = await ItemService.GetItemByIdAsync(id);
                    searchedStock = null;
                    searchedCategory = null;
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error: {ex.Message}");
            }
            isSearching = true;
        }
        else
        {
            searchedStock = null;
            searchedCategory = null;
            searchedItem = null;
            isSearching = true;
        }
        StateHasChanged();
    }

    private async Task DeleteStock(int stockID)
    {
        try
        {
            await StockService.DeleteStockAsync(stockID);
            stocks = await StockService.GetStocksAsync();
            ToastService.ShowSuccess("Stock deleted successfully.");
            isSearching = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting stock: {ex.Message}");
        }
        StateHasChanged(); // Refresh the UI
    }

    private void EditStock(int stockID)
    {
        // Implement the edit logic here
    }

    private async Task DeleteCategory(int categoryID)
    {
        try
        {
            await CategoryService.DeleteCategoryAsync(categoryID);
            categories = await CategoryService.GetCategoriesAsync();
            ToastService.ShowSuccess("Category deleted successfully.");
            isSearching = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting category: {ex.Message}");
        }
        StateHasChanged();
    }


    private void EditCategory(int categoryID)
    {
        // Implement the edit logic here
    }

    private async Task DeleteItem(int itemID)
    {
        try
        {
            await ItemService.DeleteItemAsync(itemID);
            items = await ItemService.GetItemsAsync();
            ToastService.ShowSuccess("Item deleted successfully.");
            isSearching = false;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting item: {ex.Message}");
        }
        StateHasChanged();
    }

    private void EditItem(int itemID)
    {
        // Implement the edit logic here
    }
}
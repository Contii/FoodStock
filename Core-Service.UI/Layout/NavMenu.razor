<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FoodStock</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="fa-solid fa-house me-2" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stock">
                <span class="fa-solid fa-boxes-stacked me-2" aria-hidden="true"></span> Stock
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shopping">
                <span class="fa-solid fa-basket-shopping me-2" aria-hidden="true"></span> Shopping
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="recipes">
                <span class="fa-solid fa-list-check me-2" aria-hidden="true"></span> Recipes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consumption">
                <span class="fa-solid fa-drumstick-bite me-2" aria-hidden="true"></span> Consumption
            </NavLink>
        </div>
    </nav>


    <nav class="flex-column">
    <ul>
        <li><NavLink href="/categories">Categories</NavLink></li>
        <li><NavLink href="/stocks">Stocks</NavLink></li>
        <li><NavLink href="/items">Items</NavLink></li>
    </ul>
    </nav>

</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
